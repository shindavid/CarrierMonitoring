# Carrier / Bryant cloud account (same login as the mobile app)
CARRIER_USERNAME=you@example.com
CARRIER_PASSWORD=secret
# Where to store the SQLite database
CARRIERMON_DB=data/carriermon.sqlite
# Full-refresh poll interval in seconds (websocket push fills in between)
CARRIERMON_POLL_SECONDS=300
# Delete stored data older than this many days (runs daily; 0 = keep forever)
CARRIERMON_RETENTION_DAYS=7
# Dashboard listen address/port
CARRIERMON_HOST=0.0.0.0
CARRIERMON_PORT=8471
# Dashboard login (form login + session cookie). This pair is an admin. More logins, with
# roles, are managed with `carriermon user add NAME [--role admin|user]`. Leave both blank
# and add no users to disable auth entirely (local use only).
CARRIERMON_AUTH_USER=david
CARRIERMON_AUTH_PASSWORD=change-me
# Standard users may only use the site from home (admins from anywhere). "Home" = the client's
# address matches this server's public IPv4 (exactly) or IPv6 (same /64), learned from
# these URLs every 10 min (set one empty to skip that protocol), is a private/LAN address,
# or is in this list of extra networks/addresses (comma-separated CIDRs or IPs).
CARRIERMON_HOME_NETWORKS=
CARRIERMON_PUBLIC_IP_URL=https://1.1.1.1/cdn-cgi/trace
CARRIERMON_PUBLIC_IP6_URL=https://[2606:4700:4700::1111]/cdn-cgi/trace
# Set to 1 in a dev checkout: ingest refuses to run, web is read-only (see test_dev.sh)
CARRIERMON_DEV=
# Custom heat/cool controller (see README "Controller"). Settings/state/log live in this
# checkout's own small database; the loop runs inside ingest (prod) or `carriermon control` (dev).
CARRIERMON_CONTROL_DB=data/control.sqlite
CARRIERMON_CONTROL_INTERVAL=60
# Set to 1 to make the ingest-hosted loop log decisions without writing to the thermostat
CARRIERMON_CONTROL_DRY_RUN=
