# Carrier / Bryant cloud account (same login as the mobile app)
CARRIER_USERNAME=you@example.com
CARRIER_PASSWORD=secret
# Where to store the SQLite database
CARRIERMON_DB=data/carriermon.sqlite
# Full-refresh poll interval in seconds (websocket push fills in between)
CARRIERMON_POLL_SECONDS=300
# Dashboard listen address/port
CARRIERMON_HOST=0.0.0.0
CARRIERMON_PORT=8471
